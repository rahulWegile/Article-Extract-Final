import json
from pathlib import Path

from backend.services.workspace_manager import WorkspaceManager
from backend.services.document_manager import DocumentManager
import shutil

from pipeline.render_pdf import render_pdf
from pipeline.layout_detector import LayoutDetector
from pipeline.ocr.easyocr_engine import EasyOCREngine
from pipeline.page_processor_gemini import process_page

from pipeline.continuation.continuation_detector import (
    ContinuationDetector,
)

from pipeline.continuation.article_merger import (
    ArticleMerger,
)

from pipeline.article_extraction.article_repository import (
    ArticleRepository,
)

from pipeline.gemini.newspaper_client import (
    NewspaperClient,
)

from pipeline.newspaper.newspaper_builder import (
    NewspaperBuilder,
)

from pipeline.intelligence.newspaper_intelligence import (
    NewspaperIntelligence,
)

class PipelineService:
    """
    Runs the complete Gemini newspaper pipeline.
    """

    def __init__(self):

        print()
        print("=" * 60)
        print("LOADING PIPELINE MODELS")
        print("=" * 60)

        self.detector = LayoutDetector()
        self.ocr_engine = EasyOCREngine()

        #
        # Gemini Newspaper Client
        #

        self.newspaper_client = NewspaperClient()

        print("✓ Layout Detector Loaded")
        print("✓ EasyOCR Loaded")
        print("✓ Newspaper Client Loaded")

    def process_pdf(
        self,
        pdf_path,
    ):

        print()
        print("=" * 60)
        print("PROCESSING PDF")
        print("=" * 60)

        #
        # Create temporary workspace
        #

        workspace = WorkspaceManager().create()

        print(f"Workspace : {workspace}")

        try:

            #
            # Render PDF
            #

            pages = render_pdf(

                pdf_path=pdf_path,

                output_dir=str(
                    workspace / "pages"
                ),

                dpi=300,

            )

            print(f"Rendered {len(pages)} pages")

            #
            # -------------------------------------------------
            # Extract Newspaper Metadata
            # -------------------------------------------------
            #

            print()
            print("=" * 60)
            print("NEWSPAPER METADATA")
            print("=" * 60)

            metadata = self.newspaper_client.extract_metadata(

                image_path=pages[0],

            )

            print(metadata)

            #
            # Create document first
            #

            document = DocumentManager().create_document(
                pdf_path
            )

            document_id = document["document_id"]

            document_dir = Path(
                document["document_dir"]
            )
            #
            # Store all articles by page
            #

            page_articles = {}

            #
            # Create output folders
            #

            (document_dir / "page_json").mkdir(
                parents=True,
                exist_ok=True,
            )

            (document_dir / "gemini").mkdir(
                parents=True,
                exist_ok=True,
            )

            (document_dir / "final").mkdir(
                parents=True,
                exist_ok=True,
            )

            (document_dir / "articles").mkdir(
                parents=True,
                exist_ok=True,
            )

            #
            # Process pages
            #

            for page_number, page_path in enumerate(
                pages,
                start=1,
            ):

                result = process_page(

                    page_number=page_number,

                    page_path=page_path,

                    detector=self.detector,

                    ocr_engine=self.ocr_engine,

                    document_id=document_id,

                    document_dir=document_dir,

                )

                page_articles[page_number] = result["articles"]


            #
            # -------------------------------------------------
            # Continuation Detection
            # -------------------------------------------------
            #

            print()
            print("=" * 60)
            print("CONTINUATION DETECTION")
            print("=" * 60)

            detector = ContinuationDetector()

            matches = detector.detect(
                page_articles
            )

            print(f"Matches Found : {len(matches)}")

            #
            # -------------------------------------------------
            # Build Article Lookup
            # -------------------------------------------------
            #

            article_lookup = {}

            for articles in page_articles.values():

                for article in articles:

                    article_lookup[
                        article.article_id
                    ] = article



            #
            # -------------------------------------------------
            # Merge Articles
            # -------------------------------------------------
            #

            merger = ArticleMerger()

            merged_articles = merger.merge(

                articles=article_lookup,

                matches=matches,

            )

            print(f"Merged Articles : {len(merged_articles)}")

            #
            # -------------------------------------------------
            # Save Merged Articles
            # -------------------------------------------------
            #

            repository = ArticleRepository()

            repository.save(

                articles=merged_articles,

                document_dir=document_dir,

            )

            #
            # -------------------------------------------------
            # Build Newspaper
            # -------------------------------------------------
            #

            builder = NewspaperBuilder()

            newspaper = builder.build(

                document_id=document_id,

                pdf_name=Path(pdf_path).name,

                publish_date=metadata.get(
                    "publish_date",
                    "",
                ),

                page_count=len(pages),

                articles=merged_articles,

            )

            #
            # Fill metadata
            #

            newspaper.newspaper_name = metadata.get(

                "newspaper_name",

                "",

            )

            newspaper.edition = metadata.get(

                "edition",

                "",

            )

            newspaper.language = metadata.get(

                "language",

                "",

            )

            builder.save(

                newspaper=newspaper,

                document_dir=document_dir,

            )

            #
            # -------------------------------------------------
            # Move rendered page images
            # -------------------------------------------------
            #

            shutil.move(

                str(workspace / "pages"),

                str(document_dir / "pages"),

            )

            #
            # -------------------------------------------------
            # Newspaper Intelligence
            # -------------------------------------------------
            #

            intelligence = NewspaperIntelligence()

            final_articles = intelligence.process(

                newspaper_json=document_dir / "newspaper.json",

                document_dir=document_dir,

            )

            #
            # -------------------------------------------------
            # Update metadata
            # -------------------------------------------------
            #

            metadata_file = document_dir / "document.json"

            with open(
                metadata_file,
                "r",
                encoding="utf-8",
            ) as f:

                metadata = json.load(f)

            metadata["page_count"] = len(pages)
            metadata["status"] = "completed"

            with open(
                metadata_file,
                "w",
                encoding="utf-8",
            ) as f:

                json.dump(
                    metadata,
                    f,
                    indent=4,
                )

            print()
            print("=" * 60)
            print("PIPELINE COMPLETED")
            print("=" * 60)

        finally:

            WorkspaceManager().cleanup()





