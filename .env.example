# --------------------------------------------------------
# Database
# --------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=newspaper_archive
DB_USER=postgres
DB_PASSWORD=changeme

# Connection pool sizing (pipeline/database/db.py)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --------------------------------------------------------
# API
# --------------------------------------------------------

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --------------------------------------------------------
# Pipeline
# --------------------------------------------------------

# "openai", "gemini" or "local" -- selects the article-level
# extraction engine.
ARTICLE_EXTRACTOR_ENGINE=openai

# "openai" or "gemini" -- selects the provider used for newspaper
# metadata extraction and page-level article grouping.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai or ARTICLE_EXTRACTOR_ENGINE=openai.
OPENAI_API_KEY=

# Model used for article-level extraction (per-crop OCR/field
# extraction) and, unless OPENAI_BOUNDARY_MODEL is set, for metadata
# and page-level grouping too. Set this to the exact model id from
# your OpenAI account/plan.
OPENAI_MODEL=gpt-4o-mini

# Stronger model used specifically for the page-grouping stage, which
# needs to keep block-to-article ownership exclusive across a busy
# page. Falls back to OPENAI_MODEL if unset.
OPENAI_BOUNDARY_MODEL=gpt-4o

# Model used specifically for article-level extraction (independent
# of OPENAI_MODEL/OPENAI_BOUNDARY_MODEL above). Defaults to
# gpt-5.6-luna (pipeline/intelligence/openai_article_extractor.py)
# if unset.
OPENAI_ARTICLE_MODEL=gpt-4o-mini

# Per-request timeout (seconds) for OpenAI API calls. Without this, a
# stalled network connection hangs forever instead of failing and
# retrying -- see pipeline/openai/openai_service.py. Article-batch
# requests attach many crop images at once (dozens of MB of base64
# data), which can legitimately take a few minutes to upload; 120s
# was seen to fail with a connection error on a 47-crop batch, so the
# default here is raised to give large batches enough headroom.
OPENAI_TIMEOUT_SECONDS=300

# Number of a document's pages sent to the page-grouping call
# concurrently when LLM_PROVIDER=openai (each page's call is
# independent). Higher values finish a multi-page document faster
# but issue more concurrent requests against your OpenAI quota.
OPENAI_PAGE_CONCURRENCY=4

# Upper bound (MB) on the total image payload sent in one
# article-extraction batch request to OpenAI, keeping requests well
# under the provider's total-request image-size limit -- see
# pipeline/intelligence/openai_article_extractor.py. Default: 35.
OPENAI_MAX_BATCH_IMAGE_MB=35

# Only required if LLM_PROVIDER=gemini or ARTICLE_EXTRACTOR_ENGINE=gemini.
GEMINI_API_KEY=

# "true" or "false" -- try the local OCR + template-registry masthead
# metadata extractor (pipeline/intelligence/local/masthead/) before
# falling back to the configured LLM provider. Kill switch only; the
# local extractor already falls back to the LLM on its own whenever
# it isn't confident.
LOCAL_METADATA_EXTRACTOR_ENABLED=true

# Number of a document's pages sent to Gemini's per-page article
# analysis concurrently, when LLM_PROVIDER=gemini.
GEMINI_PAGE_CONCURRENCY=4

# Per-request timeout (seconds) for Gemini API calls, when
# LLM_PROVIDER=gemini. Without this, a stalled network connection
# hangs forever instead of failing and retrying -- see
# pipeline/gemini/gemini_service.py.
GEMINI_TIMEOUT_SECONDS=120

# Model used specifically for article-level extraction, when
# ARTICLE_EXTRACTOR_ENGINE=gemini -- see
# pipeline/intelligence/gemini_article_extractor.py. Defaults to
# gemini-3.6-flash if unset.
GEMINI_ARTICLE_MODEL=gemini-3.6-flash

# Model used for the Stream B document-order pass (see
# DOCUMENT_ORDER_RECONCILE below). Falls back to GEMINI_ARTICLE_MODEL,
# then to gemini-3.6-flash, if unset -- see
# pipeline/intelligence/gemini_document_order_extractor.py.
GEMINI_DOC_ORDER_MODEL=gemini-3.6-flash

# Upper bound (MB) on the total image payload sent in one batch
# request to Gemini (article extraction and document-order both use
# this) -- see pipeline/intelligence/gemini_article_extractor.py and
# pipeline/intelligence/gemini_document_order_extractor.py.
# Default: 30.
GEMINI_MAX_BATCH_IMAGE_MB=30

# --------------------------------------------------------
# Document-order reconciliation (Hindi/Gemini only)
# --------------------------------------------------------

# "1" to enable, "0" (default) to disable. A second reconciliation
# pass (Stream B) that cross-checks Gemini's page-level article
# grouping against a whole-document reading-order extraction --
# see pipeline/intelligence/reconcile.py for the merge policy
# (Stream A stays authoritative). Only takes effect on Hindi-routed
# documents using LLM_PROVIDER=gemini; this is a new, unvalidated
# accuracy layer with a real per-document API cost, not a bug fix.
DOCUMENT_ORDER_RECONCILE=0

# Thread-pool size for the document-order pass above, when enabled --
# see backend/services/pipeline_service.py.
DOCUMENT_ORDER_CONCURRENCY=4

# --------------------------------------------------------
# OCR
# --------------------------------------------------------

# Number of pages OCR'd and prepared concurrently. RapidOCR + YOLO
# both release the GIL during their actual compute (ONNX Runtime /
# torch inference), so a small thread pool here gives a real speedup.
# Kept low by default since this competes with everything else
# running on the machine -- see backend/services/pipeline_service.py.
OCR_PAGE_CONCURRENCY=2

# "1" (default) to retry with the native PaddleOCR Devanagari engine
# when a block looks like it might contain Hindi text; "0" to
# disable the retry -- see pipeline/ocr/rapidocr_engine.py.
OCR_NATIVE_PADDLE_RETRY=1

# --------------------------------------------------------
# Ops
# --------------------------------------------------------

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=200
