.env.example:
    DB_HOST=localhost
    DB_PORT=5432
    DB_NAME=newspaper_archive
    DB_USER=postgres
    DB_PASSWORD=your_db_password_here
    GEMINI_API_KEY=your_gemini_api_key_here
    # Explicit model pins -- previously only a hardcoded "gemini-3.6-flash"
    # fallback in each file's os.getenv() default. GEMINI_ARTICLE_MODEL is
    # used by the article-extraction batch call and (as a fallback) by the
    # dormant document-order extractor; GEMINI_BOUNDARY_MODEL is used by
    # the boundary-detection/article-grouping call.
    GEMINI_ARTICLE_MODEL=gemini-3.6-flash
    GEMINI_BOUNDARY_MODEL=gemini-3.6-flash
    # Heavy multi-image batches (up to 50 crops / 40MB) plus a long
    # structured-output schema were hitting Gemini's own gateway deadline
    # at the previous 120s default, returning 504 DEADLINE_EXCEEDED before
    # the model could finish. Matches OPENAI_TIMEOUT_SECONDS below.
    GEMINI_TIMEOUT_SECONDS=300
    # Boundary detection and article extraction now route AUTOMATICALLY
    # per document, by detected language (backend/services/
    # pipeline_service.py, "document_llm_provider"): Hindi/Devanagari ->
    # Gemini (gemini-3.6-flash, confirmed this session to correctly read
    # Devanagari on a real crop that gpt-5.6-luna fabricated text for),
    # everything else -> OpenAI. Newspaper NAME/masthead metadata always
    # uses OpenAI regardless of language (that call is what determines
    # the language in the first place). ARTICLE_EXTRACTOR_ENGINE is no
    # longer read anywhere -- left unset intentionally.
    #
    # LLM_PROVIDER now only distinguishes two modes:
    #   local  -> no API calls at all (see local_grouper.py)
    #   (else) -> normal API-based mode; the Gemini/OpenAI split above
    #             is automatic and does NOT depend on this value being
    #             specifically "gemini" or "openai".
    LLM_PROVIDER=openai
    OPENAI_API_KEY=your_openai_api_key_here
    # NOTE: gpt-5.6-luna cannot read Devanagari from images -- confirmed
    # this session via direct side-by-side test: on the same real
    # headline crop it fabricated unrelated text ("संसद के बाहर सुरक्षा
    # में चूक") while gpt-4o and gpt-5.5 both read it exactly right.
    # Hindi text extraction will hallucinate again with this model set.
    OPENAI_MODEL=gpt-5.6-luna
    OPENAI_ARTICLE_MODEL=gpt-5.6-luna
    # Boundary-detection/article-grouping call (pipeline/page_processor_gemini.py
    # run_openai). Previously left unset, silently falling back through
    # OPENAI_MODEL to a hardcoded "gpt-4o-mini" default in openai_service.py --
    # pinned explicitly here to the same value it was already resolving to.
    OPENAI_BOUNDARY_MODEL=gpt-5.6-luna
    OPENAI_TIMEOUT_SECONDS=300
    
    # Hard ceiling on page-boundary/article-grouping LLM concurrency
    # (backend/services/pipeline_service.py) -- too many page-boundary
    # requests in flight at once was overloading the API and causing
    # lower page-boundary accuracy, missed boundaries, weak grouping
    # decisions, and inconsistent results on large documents. Additional
    # requests beyond this cap queue and run as soon as one of the active
    # ones finishes.
    PAGE_BOUNDARY_MAX_CONCURRENCY=2
    
    # Stream B (pipeline/intelligence/document_order_extractor.py) +
    # reconciliation (pipeline/intelligence/reconcile.py) -- reads raw
    # pages independently of boundary detection to recover heading-less
    # continuations/content lost to bad boundary splits. Adds ~11 extra
    # API calls per 22-page doc (~2-page batches), on top of the normal
    # batch/boundary calls. Already skipped automatically in local mode,
    # batch/boundary calls.
    DOCUMENT_ORDER_RECONCILE=0


    URDU_TROCR_ONLY="1"

    # GPU (RTX 2050) enabled via the project-local venv (torch/torchvision
    # CUDA cu130 builds) -- see pipeline/device.py. Only takes effect when
    # the backend is actually launched through that venv (run_backend.ps1),
    # not the global Python install, which has no CUDA torch.
    OCR_DEVICE=cuda
