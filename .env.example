# --------------------------------------------------------
# Database
# --------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=newspaper_archive
DB_USER=postgres
DB_PASSWORD=changeme

# Connection pool sizing (pipeline/database/db.py)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --------------------------------------------------------
# API
# --------------------------------------------------------

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --------------------------------------------------------
# Pipeline
# --------------------------------------------------------

# "openai", "gemini", or "local" -- selects the article-level extraction
# engine, and also which provider is used for newspaper metadata and
# page-level article grouping.
ARTICLE_EXTRACTOR_ENGINE=openai

# Required for the default "openai" engine -- no default, the app fails
# to start without this set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model used specifically for page-level article block grouping
# (pipeline/page_processor_gemini.py). gpt-4o-mini is not reliable at
# keeping block-to-article ownership exclusive on dense newspaper
# pages -- use a stronger model here. Note: gpt-4o has a much lower
# tokens-per-minute limit than gpt-4o-mini on lower OpenAI usage
# tiers, which can throttle multi-page batches; raise your usage tier
# at platform.openai.com if you see repeated rate-limit retries.
OPENAI_BOUNDARY_MODEL=gpt-4o

# Only required if ARTICLE_EXTRACTOR_ENGINE=gemini.
GEMINI_API_KEY=

# --------------------------------------------------------
# Ops
# --------------------------------------------------------

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=200
