# --------------------------------------------------------
# Database
# --------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=newspaper_archive
DB_USER=postgres
DB_PASSWORD=changeme

# Connection pool sizing (pipeline/database/db.py)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --------------------------------------------------------
# API
# --------------------------------------------------------

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --------------------------------------------------------
# Pipeline
# --------------------------------------------------------

# "openai", "gemini" or "local" -- selects the article-level
# extraction engine.
ARTICLE_EXTRACTOR_ENGINE=openai

# "openai" or "gemini" -- selects the provider used for newspaper
# metadata extraction and page-level article grouping.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai or ARTICLE_EXTRACTOR_ENGINE=openai.
OPENAI_API_KEY=

# Model used for article-level extraction (per-crop OCR/field
# extraction) and, unless OPENAI_BOUNDARY_MODEL is set, for metadata
# and page-level grouping too. Set this to the exact model id from
# your OpenAI account/plan.
OPENAI_MODEL=gpt-4o-mini

# Stronger model used specifically for the page-grouping stage, which
# needs to keep block-to-article ownership exclusive across a busy
# page. Falls back to OPENAI_MODEL if unset.
OPENAI_BOUNDARY_MODEL=gpt-4o

# Model used specifically for article-level extraction (independent
# of OPENAI_MODEL/OPENAI_BOUNDARY_MODEL above).
OPENAI_ARTICLE_MODEL=gpt-4o-mini

# Per-request timeout (seconds) for OpenAI API calls. Without this, a
# stalled network connection hangs forever instead of failing and
# retrying -- see pipeline/openai/openai_service.py. Article-batch
# requests attach many crop images at once (dozens of MB of base64
# data), which can legitimately take a few minutes to upload; 120s
# was seen to fail with a connection error on a 47-crop batch, so the
# default here is raised to give large batches enough headroom.
OPENAI_TIMEOUT_SECONDS=300

# Number of a document's pages sent to the page-grouping call
# concurrently when LLM_PROVIDER=openai (each page's call is
# independent). Higher values finish a multi-page document faster
# but issue more concurrent requests against your OpenAI quota.
OPENAI_PAGE_CONCURRENCY=4

# Only required if LLM_PROVIDER=gemini or ARTICLE_EXTRACTOR_ENGINE=gemini.
GEMINI_API_KEY=

# "true" or "false" -- try the local OCR + template-registry masthead
# metadata extractor (pipeline/intelligence/local/masthead/) before
# falling back to the configured LLM provider. Kill switch only; the
# local extractor already falls back to the LLM on its own whenever
# it isn't confident.
LOCAL_METADATA_EXTRACTOR_ENABLED=true

# Number of a document's pages sent to Gemini's per-page article
# analysis concurrently, when LLM_PROVIDER=gemini.
GEMINI_PAGE_CONCURRENCY=4

# Per-request timeout (seconds) for Gemini API calls, when
# LLM_PROVIDER=gemini. Without this, a stalled network connection
# hangs forever instead of failing and retrying -- see
# pipeline/gemini/gemini_service.py.
GEMINI_TIMEOUT_SECONDS=120

# --------------------------------------------------------
# Ops
# --------------------------------------------------------

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=200
